# ── Supabase ─────────────────────────────────────────────────────────────────
# Public (EXPO_PUBLIC_*) values are embedded in the client bundle — they are
# safe to ship because Supabase RLS + service-role-only server code protect
# the data. Never prefix secret keys with EXPO_PUBLIC_.
#
# ▶ DEMO MODE: leave both values EMPTY and the app runs fully playable with
#   a localStorage-backed demo backend (no account, no server). Add
#   credentials here to switch to the real Supabase backend.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Product configuration ────────────────────────────────────────────────────
# Used by the analytics service. When empty, events are logged to console only.
EXPO_PUBLIC_ANALYTICS_POSTHOG_KEY=

# ── Optional: submission services ────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ── EAS / builds ─────────────────────────────────────────────────────────────
# Set by `eas init` / `eas build`.
# EXPO_PUBLIC_EAS_PROJECT_ID=